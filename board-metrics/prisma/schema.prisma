generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Upload {
  id         String          @id @default(cuid())
  filename   String
  uploadedAt DateTime        @default(now())
  source     String          @default("quickbooks_export")
  records    RevenueRecord[]
}

model Customer {
  id      String          @id @default(cuid())
  name    String          @unique
  records RevenueRecord[]
}

model RevenueRecord {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  uploadId   String
  upload     Upload   @relation(fields: [uploadId], references: [id])
  month      String
  amount     Decimal
  createdAt  DateTime @default(now())

  @@unique([customerId, month, uploadId])
  @@index([month])
  @@index([customerId])
}
